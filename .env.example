# Backend version comes from server\version.py and is not environment-configurable.
# Existing pack version/API settings remain independent and required.
MARS_API_JWT_SECRET=
MARS_RELEASE_DIR=D:\path\to\release
MARS_PUBLIC_BASE_URL=https://api.nexusgit.info
DEV_TOKEN=false

# Community endpoints fail closed (503) until the separate secret is set.
# Generate a random secret of at least 32 characters; never reuse the pack secret.
MARS_AUTH_JWT_SECRET=
WEBSITE_URL=https://mars.nexusgit.info
MARS_AUTH_PUBLIC_URL=https://api.nexusgit.info
MARS_COMMUNITY_DB=data\community.sqlite3
MARS_AUTH_ALLOW_LOCAL_HTTP=false

# Register an OAuth App callback matching:
# https://api.nexusgit.info/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Deliberate local development alternative (same hostname, different ports):
# WEBSITE_URL=http://localhost:5173
# MARS_AUTH_PUBLIC_URL=http://localhost:8000
# MARS_AUTH_ALLOW_LOCAL_HTTP=true
# GitHub OAuth App callback: http://localhost:8000/api/auth/github/callback

# Private capsule buckets default beside the community database under capsule-private.
# Overrides MUST be absolute, mutually nonoverlapping and outside served/package folders.
# Run API and worker with the same service account and persistent single-host local disk.
# MARS_CAPSULE_QUARANTINE=D:\private\mars-capsules\quarantine
# MARS_CAPSULE_RETAINED=D:\private\mars-capsules\retained
# MARS_CAPSULE_EVIDENCE=D:\private\mars-capsules\evidence
MARS_CAPSULE_MAX_BYTES=67108864
MARS_CAPSULE_MAX_ACTIVE=10
MARS_CAPSULE_EXPIRY_SECONDS=604800
MARS_CAPSULE_UPLOAD_SECONDS=300
MARS_CAPSULE_LEASE_SECONDS=300
MARS_CAPSULE_MAX_ATTEMPTS=3
MARS_CAPSULE_RETRY_SECONDS=30
MARS_CAPSULE_EVIDENCE_SECONDS=86400
MARS_CAPSULE_POLICY_VERSION=capsule-v1
# Only disabled is supported; no production-clean fallback or public downloads.
MARS_CAPSULE_SCANNER=disabled
# Separate process, same environment: .\.venv\Scripts\python.exe -m server.worker --once
# Back up SQLite and all buckets consistently; never expose buckets via a static server.
